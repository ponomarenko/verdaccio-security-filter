{
  "name": "verdaccio-security-filter",
  "version": "1.5.1",
  "description": "Verdaccio security plugin: block vulnerable (CVE/OSV), malicious and newly published npm packages in your private registry to stop supply chain attacks",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "keywords": [
    "verdaccio",
    "verdaccio-plugin",
    "plugin",
    "security",
    "npm",
    "npm-security",
    "registry",
    "private-registry",
    "npm-proxy",
    "supply-chain",
    "supply-chain-security",
    "vulnerability",
    "cve",
    "osv",
    "malware",
    "license-compliance",
    "semver",
    "filter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run build && jest --testMatch \"**/*.e2e.ts\" --coverage=false",
    "debug:verdaccio": "node --inspect-brk $(which verdaccio)",
    "debug:build": "npm run build && npm link",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "verdaccio": ">=5.0.0"
  },
  "dependencies": {
    "semver": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.0.0",
    "@verdaccio/types": "^13.1.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.2.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "qs": "6.17.1",
    "@cypress/request": "4.0.1"
  },
  "author": {
    "name": "Vitaliy Ponomarenko",
    "url": "https://github.com/ponomarenko"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponomarenko/verdaccio-security-filter.git"
  },
  "bugs": {
    "url": "https://github.com/ponomarenko/verdaccio-security-filter/issues"
  },
  "homepage": "https://github.com/ponomarenko/verdaccio-security-filter#readme",
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "README.md",
    "LICENSE"
  ]
}
